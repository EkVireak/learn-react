# Copy this file to `.env` and adjust:  cp .env.example .env
# `.env` is git-ignored, so your real values never get committed.
#
# Remember: every VITE_* variable is compiled into the browser bundle and is PUBLIC.
# Never put real secrets here — they belong on a server.

# Exercise 13 – Contacts API (`npm run api:contacts`)
VITE_CONTACTS_API_URL=http://localhost:3002
VITE_CONTACTS_API_KEY=demo-key-123
